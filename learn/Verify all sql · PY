# Q4 Top Selling Products
run("Q4 Top Selling Products",
"""
CREATE TABLE products (product_id INTEGER, product_name TEXT);
CREATE TABLE order_items (order_item_id INTEGER, product_id INTEGER, quantity INTEGER, unit_price REAL);
INSERT INTO products VALUES (1,'Notebook'),(2,'Pen'),(3,'Backpack'),(4,'Desk Lamp');
INSERT INTO order_items VALUES
(1,1,10,5), (2,1,5,5), (3,2,50,1), (4,3,4,60), (5,4,3,25),(6,3,2,60);
""",
"""
SELECT p.product_name, SUM(oi.quantity * oi.unit_price) AS revenue
FROM order_items oi
JOIN products p ON p.product_id = oi.product_id
GROUP BY p.product_name
ORDER BY revenue DESC
LIMIT 3;
""")

# Q5 Employees Earning More Than Manager
run("Q5 Earning More Than Manager",
"""
