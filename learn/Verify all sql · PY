# Q7 Dedup keep latest
run("Q7 Dedup Emails",
"""
CREATE TABLE users (user_id INTEGER, email TEXT, signup_date TEXT);
INSERT INTO users VALUES
(1,'a@x.com','2024-01-01'),
(2,'a@x.com','2024-03-05'),
