import sqlite3

def run(name, schema, query):
    conn = sqlite3.connect(":memory:")
    cur = conn.cursor()
    cur.executescript(schema)
    conn.commit()
    cur.execute(query)
    cols = [d[0] for d in cur.description]
    rows = cur.fetchall()
    print(f"=== {name} ===")
    print(cols)
    for r in rows:
        print(r)
    print()
    conn.close()

# Q1 Orders by Region
run("Q1 Orders by Region",
"""
CREATE TABLE orders (order_id INTEGER, region TEXT, amount REAL);
INSERT INTO orders VALUES
(1,'North',200),(2,'North',150),(3,'North',180),
(4,'South',400),(5,'South',50),
(6,'East',600),(7,'East',100),
(8,'West',90),(9,'West',80);
""",
"""
SELECT region, SUM(amount) AS total_amount
FROM orders
GROUP BY region
HAVING SUM(amount) > 500
ORDER BY total_amount DESC;
""")

# Q2 Employee Salary Bands
run("Q2 Salary Bands",
"""
CREATE TABLE employees (emp_id INTEGER, name TEXT, salary INTEGER);
INSERT INTO employees VALUES
(1,'Ana',42000),(2,'Ben',55000),(3,'Cara',91000),(4,'Dev',48000),
(5,'Eli',67000),(6,'Fay',120000),(7,'Gus',89000),(8,'Hana',31000);
""",
"""
WITH banded AS (
  SELECT emp_id,
    CASE
      WHEN salary < 50000 THEN 'Junior'
      WHEN salary BETWEEN 50000 AND 90000 THEN 'Mid'
      ELSE 'Senior'
    END AS band
  FROM employees
)
SELECT band, COUNT(*) AS no_of_employees
FROM banded
GROUP BY band
ORDER BY no_of_employees DESC;
""")

