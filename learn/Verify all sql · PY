# Q14 Products priced above category average
run("Q14 Above Category Avg",
"""
CREATE TABLE products2 (product_id INTEGER, product_name TEXT, category TEXT, price REAL);
INSERT INTO products2 VALUES
(1,'Laptop','Electronics',800),(2,'Mouse','Electronics',20),(3,'Monitor','Electronics',300),
(4,'Desk','Furniture',150),(5,'Chair','Furniture',90);
""",
"""
SELECT p.product_name, p.category, p.price
FROM products2 p
JOIN (SELECT category, AVG(price) AS avg_price FROM products2 GROUP BY category) c
  ON p.category = c.category
WHERE p.price > c.avg_price
ORDER BY p.category, p.price DESC;
""")

