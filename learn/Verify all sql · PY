# Q9 Month over month growth
run("Q9 MoM Growth",
"""
CREATE TABLE monthly_sales2 (month TEXT, revenue INTEGER);
INSERT INTO monthly_sales2 VALUES
('2024-01',1000),('2024-02',1500),('2024-03',1200),('2024-04',1800);
""",
"""
SELECT month, revenue,
  LAG(revenue) OVER (ORDER BY month) AS prev_month_revenue,
  ROUND( (revenue - LAG(revenue) OVER (ORDER BY month)) * 100.0 / LAG(revenue) OVER (ORDER BY month), 2) AS growth_pct
FROM monthly_sales2
ORDER BY month;
""")

# Q10 Top 2 per department
run("Q10 Top 2 per Dept",
"""
CREATE TABLE emp3 (emp_id INTEGER, name TEXT, department TEXT, salary INTEGER);
INSERT INTO emp3 VALUES
(1,'Ann','Eng',95000),(2,'Bud','Eng',95000),(3,'Cid','Eng',80000),(4,'Dot','Eng',70000),
